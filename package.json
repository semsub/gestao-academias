{
  "name": "gestao-academias",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:build:android": "cd android && ./gradlew assembleDebug",
    "cap:build:ios": "cd ios && xcodebuild -workspace App.xcworkspace -scheme App -configuration Debug",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  }
}
